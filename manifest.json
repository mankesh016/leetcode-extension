{
  "manifest_version": 3,
  "name": "LeetCode Streak Dot Fixer",
  "version": "1.3.0",
  "description": "Turns the red 'missed daily' dot on LeetCode's calendar into a green checkmark once you've solved that problem late",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
